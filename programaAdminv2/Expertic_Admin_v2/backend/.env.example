# Copia este archivo como ".env" y ajusta los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Puerto local: http://localhost:3000
PORT=3000

# --- Base de datos de ESTE proyecto (la copia) ---------------------------
# Opción A (recomendada para empezar): base local en un archivo.
# Si dejas DATABASE_URL vacío se usa backend/data/local.db automáticamente.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Opción B: una copia en Turso creada con
#   turso db create expertic-db-v2 --from-db expertic-db
# DATABASE_URL=libsql://expertic-db-v2-recursosexpertic.aws-us-east-1.turso.io
# DATABASE_AUTH_TOKEN=<token de expertic-db-v2>

# --- Origen para "npm run copy-from-prod" (solo lectura) ----------------
# El script SOLO ejecuta SELECT sobre esta base. Usa un token de solo lectura:
#   turso db tokens create expertic-db --read-only
SOURCE_DATABASE_URL=libsql://expertic-db-recursosexpertic.aws-us-east-1.turso.io
SOURCE_AUTH_TOKEN=

# --- Acceso al administrador ---------------------------------------------
# Si ADMIN_PASSWORD está vacío, no se pide contraseña (solo para uso local).
ADMIN_PASSWORD=
# Cadena larga y aleatoria para firmar las sesiones.
SESSION_SECRET=

# Hosts que este proyecto tiene PROHIBIDO usar como destino (separados por coma).
# La base de producción ya viene protegida en el código.
PROTECTED_DB_HOSTS=
